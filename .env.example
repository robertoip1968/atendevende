# Porta em que o servidor Node vai escutar (Nginx faz o proxy para ela)
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Webhook do fluxo n8n usado pelo atendente virtual (rota /api/chat)
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/atende-vende
# Token da autenticação do nó Webhook do n8n
N8N_WEBHOOK_TOKEN=
# Header esperado pelo n8n (padrão: Authorization). Ex.: X-API-KEY
N8N_WEBHOOK_AUTH_HEADER=
# Prefixo do valor (padrão: Bearer para Authorization). Use "none" para token puro
N8N_WEBHOOK_AUTH_SCHEME=
